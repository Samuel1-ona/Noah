# NOAH Frontend Environment Variables

# API Base URL (Backend Service)
# For production, use your deployed backend URL (e.g., Render, Vercel, etc.)
# Example: https://noah-abw7.onrender.com
VITE_API_BASE_URL=https://noah-abw7.onrender.com

# RPC URL (Blockchain Provider)
# Default: Mantle Sepolia Testnet
VITE_RPC_URL=https://rpc.sepolia.mantle.xyz

# Chain ID
# Default: 5003 (Mantle Sepolia)
VITE_CHAIN_ID=5003

# Network Name
VITE_NETWORK=mantle-sepolia

# Contract Addresses (Optional - loaded from deployments.json if available)
# VITE_CREDENTIAL_REGISTRY_ADDRESS=0x5d311f246ef87d24B045D961aA6da62a758514f7
# VITE_ZK_VERIFIER_ADDRESS=0x96f43E12280676866bBe13E0120Bb5892fCbfE0b
# VITE_PROTOCOL_ACCESS_CONTROL_ADDRESS=0xF599F186aC6fD2a9bECd9eDEE91fd58D3Dc3dB0A
