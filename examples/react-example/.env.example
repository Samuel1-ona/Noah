# NOAH SDK - React Example Environment Variables

# API Base URL (Backend Service)
# For production, use your deployed backend URL (e.g., Render, Vercel, etc.)
# Example: https://noah-abw7.onrender.com
VITE_API_BASE_URL=https://noah-abw7.onrender.com

# RPC URL (Blockchain Provider)
# Default: Mantle Sepolia Testnet
VITE_RPC_URL=https://rpc.sepolia.mantle.xyz

# Chain ID
# Default: 5003 (Mantle Sepolia)
VITE_CHAIN_ID=5003

# Contract Addresses (Optional - defaults from SDK)
# VITE_PROTOCOL_ACCESS_CONTROL_ADDRESS=0x...
# VITE_CREDENTIAL_REGISTRY_ADDRESS=0x...
# VITE_ZK_VERIFIER_ADDRESS=0x...
